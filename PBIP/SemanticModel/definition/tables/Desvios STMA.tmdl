	measure 'ID Acumulado' =
			
			CALCULATE(
			    DISTINCTCOUNT('Desvios STMA'[ID]),
			    FILTER(
			        ALLSELECTED(dCalendario[Date]),
			        dCalendario[Date] <= MAX(dCalendario[Date])
			    )
			)
		formatString: 0
		lineageTag: 54864887-3858-43c5-b00d-b6dc24bfe190

