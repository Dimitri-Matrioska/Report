table EVM
	lineageTag: 877f8cb1-7aeb-4c76-8477-fe7b9fc0aaa8

	measure BAC = SUM('Dados Contrato'[R$ Total])
		lineageTag: 9f9c8dd2-c349-4302-b226-a9755268e839

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CPI = CALCULATE([VA Valor Agregado R$]/[CR Custo Incorrido])
		lineageTag: c634edd2-6c14-4e0c-8122-60cfb1b9a79e

	measure 'CR Custo Incorrido' = ```
			
			VAR ValorBase =
			CALCULATE(
			    MAX('Medições'[R$ Acumulado]),
			    
			    FILTER(
			        ALL(dCalendario),
			        YEAR(dCalendario[Date]) = 2026
			            && MONTH(dCalendario[Date]) <= MONTH(MAX(dCalendario[Date]))
			    )
			)
			    RETURN
			IF(
			    SELECTEDVALUE('Dados Contrato'[Contratada]) = "TERRAM ENGENHARIA DE INFRAESTRUTURA S.A.",
			    ValorBase - 12825000,
			    ValorBase
			)
			
			```
		lineageTag: 6433ba2a-51ab-49ea-b70e-737a234956c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CV = CALCULATE([VA Valor Agregado R$]-[CR Custo Incorrido])
		lineageTag: 0d197dac-bcd5-4441-a5b3-42ceb809bf7c

	measure EAC = CALCULATE([BAC]/[CPI])
		lineageTag: 771f473f-09a7-4135-a5ae-435b578b3428

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SPI = divide([VA Valor Agregado R$],[VP Valor Planejado R$])
		lineageTag: 54770e90-ca90-4e71-91c9-b73d27e46904

	measure SV = CALCULATE([VA Valor Agregado R$]-[VP Valor Planejado R$])
		lineageTag: 5f06d790-5414-4e9a-a76d-9fea66b903fb

	measure 'VA Valor Agregado R$' = CALCULATE((max('Dados Contrato'[R$ Total])*(max('% Físico Total'[Real Acum]))))
		lineageTag: 8d5e3bdf-c55a-4965-b5e4-011ca9b4cc3a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'VP Valor Planejado R$' = ```
			
			VAR ValorBase =
			CALCULATE( 
			    MAX('Medições'[Baseline Acumulada]), 
			    FILTER( 'dCalendario', 'dCalendario'[Date].[Ano] = 2026 ) )
			    RETURN
			IF(
			    SELECTEDVALUE('Dados Contrato'[Contratada]) = "TERRAM ENGENHARIA DE INFRAESTRUTURA S.A.",
			    ValorBase - 12825000,
			    ValorBase
			)
			
			```
		lineageTag: dd9d1667-963d-4ecd-8b9a-f8de71e74455

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Coluna 1'
		dataType: string
		lineageTag: c2d0d471-4796-46f3-a0af-371e6c95183a
		summarizeBy: none
		sourceColumn: Coluna 1

		annotation SummarizationSetBy = Automatic

	partition EVM = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

