table 'Dados Contrato'
	lineageTag: 0b4aca7b-8af9-480c-93b2-05feb55178c1

	measure '% Medido' =
			
			CALCULATE(
			    DIVIDE(
			        sum('Dados Contrato'[Medido]),
			        SUM('Dados Contrato'[R$ Total]),
			        0
			    ),
			    'Dados Contrato'[ID Contrato] <> "123456"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a41afc5-9dd7-4cc7-ad4a-1235540b2f09

