table '% Físico Total'
	lineageTag: 7da9e313-2409-41d0-9594-9f50810581c3

	measure 'Aderência Acumulada' =
			
			
			VAR UltimaDataMes =
			    MAX(dCalendario[Date])
			
			RETURN
			CALCULATE(
			    DIVIDE(
			        MAX('% Físico Total'[Real Acum]),
			        MAX('% Físico Total'[Baseline 1 Acum]),
			        0
			    ),
			    dCalendario[Date] = UltimaDataMes
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 761a07c6-4664-4505-9002-f332c6c8f3b0

	measure '_Aderência projetada' =
			
			DIVIDE(
			    MAX('% Físico Total'[Projetado Acum]),
			    CALCULATE(
			        MAX('% Físico Total'[Baseline 1 Acum]),
			        KEEPFILTERS(VALUES(dCalendario[SemanaDoProjeto]))
			    ),
			    BLANK()
			)
		formatString: 0%;-0%;0%
		lineageTag: d4180203-4828-4ca2-8539-485934e81dea

	measure 'Cor Aderência' =
			
			VAR DataStatus =
			    CALCULATE (
			        MAX ( dCalendario[Date] ),
			        '% Físico Total'[Real Acum] <> BLANK (),
			        ALLSELECTED ( dCalendario[Date] )
			    )
			VAR MesAtual    = MAX ( dCalendario[Date] )
			VAR Real        = SUM ( '% Físico Total'[Real Acum] )
			VAR Tendencia   = SUM ( '% Físico Total'[Projetado Acum] )
			VAR Replanejado = SUM ( '% Físico Total'[Baseline 1 Acum] )
			VAR Realizado   = IF ( MesAtual <= DataStatus, Real, Tendencia )
			VAR Aderencia   = DIVIDE ( Realizado, Replanejado )
			RETURN
			    SWITCH (
			        TRUE (),
			        Aderencia < 0.95,  "#C00000",   // vermelho – abaixo de 95%
			        Aderencia < 1.00,  "#E0A800",   // amarelo – entre 95% e 100%
			        "#2E9E5B"                       // verde – 100% ou mais
			    )
		lineageTag: 1aadb3db-1e7d-484d-bff2-d2c1874c2ee5

	measure 'Aderência Semana' =
			
			VAR SemanaMax =
			    MAX(dCalendario[SemanaDoProjeto])
			
			VAR RealAcumUltimaSemana =
			    CALCULATE(
			        MAX('% Físico Total'[Real Acum]),
			        FILTER(
			            ALL(dCalendario),
			            dCalendario[SemanaDoProjeto] = SemanaMax
			        )
			    )
			
			VAR BaselineAcumUltimaSemana =
			    CALCULATE(
			        MAX('% Físico Total'[Baseline 1 Acum]),
			        FILTER(
			            ALL(dCalendario),
			            dCalendario[SemanaDoProjeto] = SemanaMax
			        )
			    )
			
			RETURN
			DIVIDE(
			    RealAcumUltimaSemana,
			    BaselineAcumUltimaSemana,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4079aaad-9a06-487b-af3a-78de63a58993

	measure _Desvio = CALCULATE(MAX('% Físico Total'[Real Acum])-max('% Físico Total'[Baseline 1 Acum]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 46717858-aa3e-467c-ab76-29164c796e00

	measure '_A realizar' = 1
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 71970a96-5b5a-48ce-9086-8fa1d60bc254

	measure '_BL a realizar' = 1
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8c193873-f1f1-4b8c-a8cf-6e2a48c7a8a2

	measure 'Aderência mês' =
			
			VAR SemanaMax =
			    MAX(dCalendario[Date])
			
			VAR RealAcumUltimaSemana =
			    CALCULATE(
			        MAX('% Físico Total'[Real Acum]),
			        FILTER(
			            ALL(dCalendario),
			            dCalendario[Date] = SemanaMax
			        )
			    )
			
			VAR BaselineAcumUltimaSemana =
			    CALCULATE(
			        MAX('% Físico Total'[Baseline 1 Acum]),
			        FILTER(
			            ALL(dCalendario),
			            dCalendario[Date] = SemanaMax
			        )
			    )
			
			RETURN
			DIVIDE(
			    RealAcumUltimaSemana,
			    BaselineAcumUltimaSemana,
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5acf3fbd-8c7d-4b0d-af13-2da5217c2c81

