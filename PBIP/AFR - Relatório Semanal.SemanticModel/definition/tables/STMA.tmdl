table STMA
	lineageTag: d2b581a2-264f-47b0-8c7d-fe987f7bc2b7

	measure 'HHT mensal' =
			
			VAR Atual =
			    MAX(STMA[HH Acum])
			
			VAR MesAnterior =
			    CALCULATE(
			        MAX(STMA[HH Acum]),
			        PREVIOUSMONTH(STMA[Mês Referência].[Date])
			    )
			
			RETURN
			    Atual - MesAnterior
		lineageTag: df3fad72-cb6f-4ecb-87bd-e1e42d342b0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dias seguros' =
			VAR DataInicio = DATE(2026, 3, 9)
			VAR DataFiltro = MAX('dCalendario'[Date])
			RETURN
			IF(
			    DataFiltro < DataInicio,
			    BLANK(),
			    DATEDIFF(DataInicio, DataFiltro, DAY) + 1
			)
		formatString: 0
		lineageTag: d0b2207b-b1f4-4fa6-98eb-25d0adc174b0

