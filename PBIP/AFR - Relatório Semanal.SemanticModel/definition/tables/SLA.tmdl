	partition SLA = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(Web.Contents("https://afonline.sharepoint.com/sites/70-OBoticario-ProjetoAfrodite/Shared%20Documents/02%20Planejamento/00%20Dados%20Report%20BI/Dados%20Gerais%20-%20Report%20AFR.xlsx"), null, true),
				    SLA_Sheet = Fonte{[Item="SLA",Kind="Sheet"]}[Data],
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(SLA_Sheet, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"Validação", type text}, {"ID Contrato", Int64.Type}, {"Contratada", type text}, {"Mês", type date}, {"Indicador", type text}, {"Descrição", type text}, {"Meta", type text}, {"Range", type text}, {"Variação mínima", type number}, {"Variação máxima", type number}, {"Frequência", type text}, {"Resultado", type any}, {"Aplicação SLA", Percentage.Type}, {"Observação", type text}})
				in
				    #"Tipo Alterado"

	annotation PBI_ResultType = Table

