table SLA
	lineageTag: 29ef3d98-af25-405d-903b-e8c3659d21ae

	measure 'SLA Máximo' = MAX(SLA[Aplicação SLA])
		lineageTag: f86f2a0d-1314-4958-b773-a07aa8769abb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA range' =
			
			VAR Resultado = SUM(SLA[Aplicação SLA])
			VAR LimiteSuperior = 0.02
			VAR LimiteInferior = -0.02
			
			RETURN
			MIN(
			    LimiteSuperior,
			    MAX(LimiteInferior, Resultado)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3802aeea-a38e-437f-9eed-b62c5f0e0f8f

