	partition Medições = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(Web.Contents("https://afonline.sharepoint.com/sites/70-OBoticario-ProjetoAfrodite/Shared%20Documents/02%20Planejamento/00%20Dados%20Report%20BI/Dados%20Gerais%20-%20Report%20AFR.xlsx"), null, true),
				    Medições_Sheet = Fonte{[Item="Medições",Kind="Sheet"]}[Data],
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Medições_Sheet, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"Mês Referência", type date}, {"R$ Total", type number}, {"Baseline Financeira", type number}, {"Baseline Acumulada", type number}, {"Nº Medição", type number}, {"R$ Medição", type number}, {"Data Medição", type date}, {"R$ Acumulado", type number}, {"R$ Saldo", type number}, {"R$ Retenção", type number}, {"Aderência", type number}, {"R$ Projeção", type number}, {"SLA", type number}}),
				    #"Somente as Colunas Selecionadas Foram Transformadas em Linhas" = Table.Unpivot(#"Tipo Alterado", {"R$ Retenção", "SLA", "R$ Projeção", "R$ Medição"}, "Atributo", "Valor"),
				    #"Valor Substituído" = Table.ReplaceValue(#"Somente as Colunas Selecionadas Foram Transformadas em Linhas","SLA","R$ SLA",Replacer.ReplaceText,{"Atributo"})
				in
				    #"Valor Substituído"

	annotation PBI_ResultType = Table

