table Medições
	lineageTag: bfac6ba6-1167-4b4d-a828-8de2b6d9ba82

	measure _Saldo = CALCULATE(SUM('Dados Contrato'[R$ Total])-'Medições'[_Medições], 'Medições'[Status]="Aprovada")
		formatString: #,0.00
		lineageTag: 197560db-f708-472b-aa18-7ff54c672670

	measure _Medições =
			
			VAR DataMax =
			    MAX(dCalendario[Date])
			
			RETURN
			CALCULATE(
			    SUM('Medições'[Valor]),
			    FILTER(
			        ALLSELECTED(dCalendario),
			        dCalendario[Date] <= DataMax
			    )
			)
		lineageTag: c878cf2f-e0ad-44e5-876a-d87cba5c01e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Saldo BL' = max('Medições'[R$ Total])
		formatString: #,0.00
		lineageTag: f15c5e39-c5bf-419e-ad14-8f592688c919

	measure '_Desvio Medição' = calculate(max('Medições'[R$ Acumulado])-max('Medições'[Baseline Acumulada]))
		formatString: #,0.00
		lineageTag: 60e6e8ad-a177-498c-8b8d-736a618c4ba1

